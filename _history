{"entries":[{"timestamp":1795500150689,"editorVersion":"4.1.28","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":900,"diffs":[[1," "]]}]}]},{"timestamp":1795670493465,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":897,"length1":2,"diffs":[[1,"})\n"]]}]}]},{"timestamp":1795670495545,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":123,"diffs":[[1,"    \"name\": \"SEROUE\",\n    \"description\": \"\",\n"]]},{"start1":153,"length1":149,"diffs":[[1,"        \"assets.json\"\n"]]},{"start1":214,"length1":71,"diffs":[[1,"    \"languageRestriction\": \"javascript-only\"\n"]]}]},{"type":"added","filename":"actors.ts","value":"namespace Harmonics {\n    export function createActors(): void {\n        if (playerSprites.length == 0) {\n            playerSprites.push(sprites.create(img`\n                . 3 3 3 .\n                3 3 3 3 3\n                3 1 3 1 3\n                3 3 3 3 3\n                . 3 3 3 .\n                . 3 3 3 .\n                3 . 3 . 3\n                3 . . . 3\n                3 . . . 3\n            `, SpriteKind.Player))\n            playerSprites.push(sprites.create(img`\n                . 9 9 9 .\n                9 9 9 9 9\n                9 1 9 1 9\n                9 9 9 9 9\n                . 9 9 9 .\n                . 9 9 9 .\n                9 . 9 . 9\n                9 . . . 9\n                9 . . . 9\n            `, SpriteKind.Player))\n        }\n    }\n\n    export function createCoreActor(): void {\n        if (coreSprite) {\n            coreSprite.destroy()\n            coreSprite = null\n        }\n\n        if (coreType == \"heavy\") {\n            coreSprite = sprites.create(img`\n                . 8 8 8 8 . .\n                8 8 8 8 8 8 .\n                8 8 8 8 8 8 8\n                8 8 1 1 8 8 8\n                8 8 8 8 8 8 8\n                . 8 8 8 8 8 .\n                . . 8 8 8 . .\n            `, SpriteKind.Food)\n        } else if (coreType == \"spark\") {\n            coreSprite = sprites.create(img`\n                . . . c . . .\n                . . c 3 c . .\n                . c 3 c 3 c .\n                c 3 c 3 c 3 3\n                . c 3 c 3 c .\n                . . c 3 c . .\n                . . . c . . .\n            `, SpriteKind.Food)\n        }\n    }\n\n    export function destroyActors(): void {\n        for (let i = 0; i < playerSprites.length; i++) {\n            playerSprites[i].destroy()\n        }\n        playerSprites = []\n\n        if (coreSprite) {\n            coreSprite.destroy()\n            coreSprite = null\n        }\n    }\n\n    export function syncActors(): void {\n        for (let i = 0; i < playerSprites.length; i++) {\n            playerSprites[i].setPosition(\n                Math.round(playerX[i] + PLAYER_W / 2),\n                Math.round(playerY[i] + PLAYER_H / 2)\n            )\n        }\n\n        if (coreSprite) {\n            coreSprite.setPosition(Math.round(coreX), Math.round(coreY))\n        }\n    }\n}"},{"type":"added","filename":"controls.ts","value":"namespace Harmonics {\n    function cycleMood(direction: number): void {\n        moodIndex += direction\n        if (moodIndex < -1) moodIndex = 2\n        if (moodIndex > 2) moodIndex = -1\n    }\n\n    export function registerControls(): void {\n        controller.left.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"menu\") {\n                selectedMode = 1\n            } else if (gameState == \"end\") {\n                cycleMood(-1)\n            }\n        })\n\n        controller.right.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"menu\") {\n                selectedMode = 2\n            } else if (gameState == \"end\") {\n                cycleMood(1)\n            }\n        })\n\n        controller.up.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"menu\") cycleMood(-1)\n            else if (gameState == \"end\") cycleMood(-1)\n        })\n\n        controller.down.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"menu\") cycleMood(1)\n            else if (gameState == \"end\") cycleMood(1)\n        })\n\n        controller.A.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"menu\") {\n                startGame()\n            } else if (gameState == \"play\") {\n                shareCore(mode == 1 ? activePlayer : 0)\n            } else if (gameState == \"end\") {\n                if (preMood < 0) {\n                    gameState = \"thanks\"\n                } else if (moodIndex < preMood) {\n                    endMoodIndex = 0\n                    gameState = \"thanks\"\n                } else if (moodIndex == preMood) {\n                    endMoodIndex = 1\n                    gameState = \"thanks\"\n                } else {\n                    endMoodIndex = 2\n                    gameState = \"thanks\"\n                }\n            } else if (gameState == \"thanks\") {\n                showMenu()\n            }\n        })\n\n        controller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"menu\") {\n                soundEnabled = !soundEnabled\n            } else if (gameState == \"end\") {\n                showMenu()\n            }\n        })\n\n        controller.menu.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"play\") {\n                if (mode == 1 && !controller.B.isPressed()) {\n                    activePlayer = 1 - activePlayer\n                } else {\n                    restartRoom()\n                }\n            } else if (gameState == \"end\" || gameState == \"thanks\") {\n                showMenu()\n            }\n        })\n\n        controller.player2.A.onEvent(ControllerButtonEvent.Pressed, function () {\n            if (gameState == \"play\" && mode == 2) shareCore(1)\n        })\n    }\n\n    export function startGame(): void {\n        mode = selectedMode\n        preMood = moodIndex\n        gameState = \"play\"\n        createActors()\n        loadRoom(0)\n        playChime(440, 180)\n    }\n\n    export function finishGame(): void {\n        gameState = \"end\"\n        moodIndex = 0\n        endMoodIndex = moodIndex\n        destroyActors()\n        playChime(784, 400)\n    }\n\n    export function showMenu(): void {\n        destroyActors()\n        gameState = \"menu\"\n        selectedMode = 1\n        moodIndex = -1\n        preMood = -1\n        playChime(330, 150)\n    }\n}\n"},{"type":"added","filename":"physics.ts","value":"namespace Harmonics {\n    function rectanglesOverlap(\n        x: number, y: number, w: number, h: number, r: Rect\n    ): boolean {\n        return x < r.x + r.w && x + w > r.x && y < r.y + r.h && y + h > r.y\n    }\n\n    function inputLeft(index: number): boolean {\n        if (mode == 1 && index != activePlayer) return false\n        if (mode == 2 && index == 1) return controller.player2.left.isPressed()\n        return controller.left.isPressed()\n    }\n\n    function inputRight(index: number): boolean {\n        if (mode == 1 && index != activePlayer) return false\n        if (mode == 2 && index == 1) return controller.player2.right.isPressed()\n        return controller.right.isPressed()\n    }\n\n    function inputJump(index: number): boolean {\n        if (mode == 1 && index != activePlayer) return false\n        if (mode == 2 && index == 1) return controller.player2.up.isPressed()\n        return controller.up.isPressed()\n    }\n\n    export function breathingHeld(): boolean {\n        if (mode == 1) return controller.B.isPressed()\n        return controller.B.isPressed() || controller.player2.B.isPressed()\n    }\n\n    export function updatePlayers(dt: number): void {\n        let solids = getSolidRects()\n\n        for (let i = 0; i < 2; i++) {\n            let speed = 35\n            let jumpSpeed = 124\n\n            if (playerHolding[i] && coreType == \"heavy\") {\n                speed = 15\n                jumpSpeed = 84\n            } else if (playerHolding[i] && coreType == \"spark\") {\n                speed = 77\n                jumpSpeed = 142\n            }\n\n            let direction = 0\n            if (inputLeft(i)) direction -= 1\n            if (inputRight(i)) direction += 1\n\n            let vx = direction * speed\n            if (vx != 0) playerFacing[i] = vx > 0 ? 1 : -1\n\n            // Horizontal movement and solid-platform collision.\n            playerX[i] += vx * dt\n            for (let j = 0; j < solids.length; j++) {\n                let r = solids[j]\n                if (rectanglesOverlap(playerX[i], playerY[i], PLAYER_W, PLAYER_H, r)) {\n                    if (vx > 0) playerX[i] = r.x - PLAYER_W\n                    else if (vx < 0) playerX[i] = r.x + r.w\n                }\n            }\n            playerX[i] = clamp(playerX[i], 0, SCREEN_W - PLAYER_W)\n\n            // Vertical movement, including jumping and gravity.\n            playerVY[i] += PLAYER_GRAVITY * dt\n            if (inputJump(i) && playerOnGround[i]) {\n                playerVY[i] = -jumpSpeed\n                playerOnGround[i] = false\n            }\n\n            playerY[i] += playerVY[i] * dt\n            playerOnGround[i] = false\n            for (let j = 0; j < solids.length; j++) {\n                let r = solids[j]\n                if (rectanglesOverlap(playerX[i], playerY[i], PLAYER_W, PLAYER_H, r)) {\n                    if (playerVY[i] > 0) {\n                        playerY[i] = r.y - PLAYER_H\n                        playerOnGround[i] = true\n                    } else if (playerVY[i] < 0) {\n                        playerY[i] = r.y + r.h\n                    }\n                    playerVY[i] = 0\n                }\n            }\n\n            // Falling never costs a life; the character simply returns to start.\n            if (playerY[i] > SCREEN_H + 13) {\n                playerX[i] = i == 0 ? 50 * SCALE_X : 100 * SCALE_X\n                playerY[i] = 480 * SCALE_Y - PLAYER_H\n                playerVY[i] = 0\n                playerOnGround[i] = false\n            }\n        }\n\n        syncActors()\n    }\n\n    export function updateCore(dt: number): void {\n        if (!coreSprite) return\n\n        if (coreHeldBy >= 0) {\n            coreX = playerX[coreHeldBy] + PLAYER_W / 2\n            coreY = playerY[coreHeldBy] - 4\n        } else if (!corePlaced) {\n            coreVY += PLAYER_GRAVITY * dt\n            coreY += coreVY * dt\n\n            let solids = getSolidRects()\n            for (let i = 0; i < solids.length; i++) {\n                let r = solids[i]\n                if (coreX >= r.x && coreX <= r.x + r.w &&\n                    coreY + 2.5 >= r.y && coreY + 2.5 <= r.y + r.h + 10 &&\n                    coreVY >= 0) {\n                    coreY = r.y - 2.5\n                    coreVY = 0\n                }\n            }\n\n            if (coreY > SCREEN_H + 13) {\n                coreY = 300 * SCALE_Y\n                coreVY = 0\n            }\n        }\n\n        syncActors()\n    }\n\n    function playerDistanceToCore(index: number): number {\n        let dx = playerX[index] + PLAYER_W / 2 - coreX\n        let dy = playerY[index] + PLAYER_H / 2 - coreY\n        return dx * dx + dy * dy\n    }\n\n    function playersClose(first: number, second: number): boolean {\n        let dx = playerX[first] + PLAYER_W / 2 - playerX[second] - PLAYER_W / 2\n        let dy = playerY[first] + PLAYER_H / 2 - playerY[second] - PLAYER_H / 2\n        return dx * dx + dy * dy < 22 * 22\n    }\n\n    export function shareCore(index: number): void {\n        if (!coreSprite || corePlaced) return\n\n        let other = 1 - index\n\n        if (playerHolding[index]) {\n            let onPlate = plateRect.w > 0 &&\n                playerX[index] + PLAYER_W > plateRect.x &&\n                playerX[index] < plateRect.x + plateRect.w &&\n                Math.abs(playerY[index] + PLAYER_H - plateRect.y) < 5.5\n\n            if (onPlate) {\n                playerHolding[index] = false\n                coreHeldBy = -1\n                corePlaced = true\n                coreX = plateRect.x + plateRect.w / 2\n                coreY = plateRect.y - 2.5\n                coreVY = 0\n                playChime(520, 220)\n            } else if (!playerHolding[other] && playersClose(index, other)) {\n                playerHolding[index] = false\n                playerHolding[other] = true\n                coreHeldBy = other\n                playChime(392, 180)\n            } else {\n                // A press away from the partner or plate drops the core.\n                playerHolding[index] = false\n                coreHeldBy = -1\n                coreVY = 0\n            }\n        } else if (coreHeldBy < 0 && playerDistanceToCore(index) < 13.5 * 13.5) {\n            playerHolding[index] = true\n            coreHeldBy = index\n            playChime(330, 180)\n        }\n\n        syncActors()\n    }\n\n    export function updateGame(dt: number): void {\n        breathClock += dt\n        let held = breathingHeld()\n        if (held) lastBreathTime = breathClock\n\n        let inhalePhase = breathClock % 9 < 4\n        if (roomIndex == 0 && fogProgress < 1 &&\n            breathClock - lastBreathTime < 2.5 && held == inhalePhase) {\n            let before = fogProgress\n            fogProgress = Math.min(1, fogProgress + dt / 14)\n            if (before < 1 && fogProgress >= 1) {\n                playChime(660, 350)\n            }\n        }\n\n        updatePlayers(dt)\n        updateCore(dt)\n\n        let atExit = true\n        for (let i = 0; i < 2; i++) {\n            let overlapsExit = playerX[i] + PLAYER_W > exitRect.x &&\n                playerX[i] < exitRect.x + exitRect.w &&\n                playerY[i] + PLAYER_H > exitRect.y &&\n                playerY[i] < exitRect.y + exitRect.h\n            if (!overlapsExit) atExit = false\n        }\n\n        if (atExit) {\n            exitTimer += dt\n            if (exitTimer > 0.9) nextRoom()\n        } else {\n            exitTimer = 0\n        }\n    }\n}"},{"type":"added","filename":"render.ts","value":"namespace Harmonics {\n    function addStars(): void {\n        for (let i = 0; i < 26; i++) {\n            let x = (i * 37 + 11) % SCREEN_W\n            let y = (i * 19 + 7) % 70\n            backgroundImage.setPixel(x, y, i % 4 == 0 ? 9 : 1)\n        }\n    }\n\n    function drawMenu(): void {\n        backgroundImage.fill(12)\n        addStars()\n        backgroundImage.fillRect(14, 17, 132, 2, 8)\n        backgroundImage.fillRect(22, 44, 116, 1, 9)\n        backgroundImage.print(\"HARMONICS\", 40, 24, 1)\n        backgroundImage.print(\"TWO LIGHTS, ONE QUIET WORLD\", 13, 34, 9)\n        backgroundImage.print(\"MODE: \" + (selectedMode == 1 ? \"SOLO\" : \"TWO PLAYERS\"), 39, 54, 5)\n        backgroundImage.print(\"LEFT / RIGHT: MODE\", 31, 66, 1)\n        backgroundImage.print(\"MOOD: \" + moodName(moodIndex), 35, 78, 9)\n        backgroundImage.print(\"UP / DOWN: MOOD\", 36, 89, 1)\n        backgroundImage.print(\"A: START   B: SOUND\", 29, 104, 5)\n        backgroundImage.print(soundEnabled ? \"SOUND ON\" : \"SOUND OFF\", 62, 113, 1)\n    }\n\n    function drawPlatform(r: Rect, color: number, thickFloor: boolean): void {\n        let height = Math.max(2, Math.round(r.h))\n        if (thickFloor) height = Math.max(height, SCREEN_H - Math.round(r.y))\n        backgroundImage.fillRect(\n            Math.round(r.x), Math.round(r.y),\n            Math.max(1, Math.round(r.w)), height, color\n        )\n        backgroundImage.fillRect(\n            Math.round(r.x), Math.round(r.y),\n            Math.max(1, Math.round(r.w)), 1, 9\n        )\n    }\n\n    function drawPortal(): void {\n        let x = Math.round(exitRect.x)\n        let y = Math.round(exitRect.y)\n        backgroundImage.drawRect(x, y, Math.round(exitRect.w), Math.round(exitRect.h), 5)\n        backgroundImage.drawRect(x + 2, y + 2, Math.round(exitRect.w) - 4, Math.round(exitRect.h) - 4, 9)\n        backgroundImage.fillRect(x + 4, y + 6, 2, Math.round(exitRect.h) - 12, 12)\n    }\n\n    function drawPlateAndGate(): void {\n        if (plateRect.w > 0) {\n            let plateColor = corePlaced ? 5 : 9\n            backgroundImage.fillRect(\n                Math.round(plateRect.x), Math.round(plateRect.y) - 1,\n                Math.round(plateRect.w), 2, plateColor\n            )\n            backgroundImage.drawRect(\n                Math.round(plateRect.x + plateRect.w / 2 - 3),\n                Math.round(plateRect.y - 9), 6, 7, 5\n            )\n        }\n\n        if (gateStyle == \"door\") {\n            let color = corePlaced ? 9 : 5\n            backgroundImage.fillRect(\n                Math.round(gateRect.x), Math.round(gateRect.y),\n                Math.max(2, Math.round(gateRect.w)), Math.round(gateRect.h),\n                corePlaced ? 12 : color\n            )\n            if (corePlaced) {\n                backgroundImage.drawRect(\n                    Math.round(gateRect.x), Math.round(gateRect.y),\n                    Math.max(2, Math.round(gateRect.w)), Math.round(gateRect.h), 5\n                )\n            }\n        } else if (gateStyle == \"bridge\") {\n            if (corePlaced) {\n                drawPlatform(gateRect, 5, false)\n            } else {\n                backgroundImage.drawRect(\n                    Math.round(gateRect.x), Math.round(gateRect.y),\n                    Math.round(gateRect.w), 3, 9\n                )\n            }\n        }\n    }\n\n    function drawBreathingGuide(): void {\n        let phase = breathClock % 9\n        let inhale = phase < 4\n        let radius = inhale ? 5 + phase * 1.5 : 11 - (phase - 4) * 1.2\n        let cx = 80\n        let cy = 53\n        let size = Math.round(radius * 2)\n\n        backgroundImage.drawRect(\n            Math.round(cx - radius), Math.round(cy - radius), size, size, 1\n        )\n        backgroundImage.fillRect(cx - 2, cy - 2, 5, 5, breathingHeld() ? 5 : 9)\n        backgroundImage.print(inhale ? \"BREATHE IN\" : \"BREATHE OUT\", 52, 72, 1)\n        backgroundImage.drawRect(48, 87, 64, 4, 1)\n        backgroundImage.fillRect(49, 88, Math.round(62 * fogProgress), 2, 5)\n    }\n\n    function drawGame(): void {\n        backgroundImage.fill(12)\n        backgroundImage.fillRect(0, 78, SCREEN_W, 42, 8)\n        backgroundImage.fillRect(0, 94, SCREEN_W, 26, 12)\n        addStars()\n\n        for (let i = 0; i < basePlatforms.length; i++) {\n            drawPlatform(basePlatforms[i], 8, basePlatforms[i].h > 8)\n        }\n\n        if (roomIndex == 0 && fogProgress >= 1) {\n            for (let i = 0; i < floatingPlatforms.length; i++) {\n                drawPlatform(floatingPlatforms[i], 9, false)\n            }\n        }\n\n        drawPlateAndGate()\n        drawPortal()\n\n        // The fog is a solid-color veil in Arcade. The original soft gradient\n        // and animated particles are replaced with a lighter pixel overlay.\n        if (roomIndex == 0 && fogProgress < 1) {\n            backgroundImage.fillRect(50, 0, 60, 120, 9)\n            for (let i = 0; i < 8; i++) {\n                let x = 53 + ((i * 17 + Math.round(breathClock * 8)) % 54)\n                let y = 23 + ((i * 13) % 74)\n                backgroundImage.setPixel(x, y, 1)\n            }\n            drawBreathingGuide()\n        }\n\n        // Draw the HUD after the fog veil so its text stays readable.\n        backgroundImage.print(\n            (roomIndex + 1) + \"/3 \" + roomName(roomIndex), 2, 2, 1\n        )\n        backgroundImage.print(roomHintOne(roomIndex), 2, 10, 9)\n        backgroundImage.print(roomHintTwo(roomIndex), 2, 18, 1)\n\n        if (mode == 1) {\n            backgroundImage.print(\"ACTIVE: \" + (activePlayer == 0 ? \"LUMI\" : \"NOX\"), 2, 28, 5)\n            backgroundImage.print(\"MENU: SWITCH\", 106, 2, 1)\n        } else {\n            backgroundImage.print(\"P1: LUMI  P2: NOX\", 2, 28, 5)\n            backgroundImage.print(\"MENU: RESET\", 105, 2, 1)\n        }\n\n        if (exitTimer > 0) {\n            backgroundImage.fillRect(72, 116, Math.round(16 * Math.min(1, exitTimer / 0.9)), 2, 5)\n        }\n    }\n\n    function drawEnd(): void {\n        backgroundImage.fill(12)\n        addStars()\n        backgroundImage.print(\"YOU MADE IT THROUGH\", 17, 25, 1)\n        backgroundImage.print(\"EVERY ROOM IS EASIER\", 25, 43, 9)\n        backgroundImage.print(\"WHEN IT IS SHARED.\", 32, 53, 9)\n        backgroundImage.print(\"HOW DO YOU FEEL NOW?\", 23, 72, 1)\n        backgroundImage.print(\"MOOD: \" + moodName(moodIndex), 42, 85, 5)\n        backgroundImage.print(\"LEFT / RIGHT: CHOOSE\", 25, 97, 1)\n        backgroundImage.print(\"A: CONFIRM  B: MENU\", 24, 108, 9)\n    }\n\n    function drawThanks(): void {\n        backgroundImage.fill(12)\n        addStars()\n        backgroundImage.print(\"THANKS FOR CHECKING IN\", 14, 32, 1)\n        if (preMood < 0) {\n            backgroundImage.print(\"TAKE THINGS AT YOUR PACE.\", 12, 56, 9)\n        } else if (endMoodIndex == 0) {\n            backgroundImage.print(\"GLAD THINGS FEEL LIGHTER.\", 12, 56, 9)\n        } else if (endMoodIndex == 1) {\n            backgroundImage.print(\"THE SAME IS OKAY, TOO.\", 15, 56, 9)\n        } else {\n            backgroundImage.print(\"THANKS FOR BEING HONEST.\", 10, 56, 9)\n        }\n        backgroundImage.print(\"A: BACK TO MENU\", 39, 91, 5)\n    }\n\n    export function render(): void {\n        if (!backgroundImage) return\n\n        if (gameState == \"menu\") {\n            drawMenu()\n        } else if (gameState == \"play\") {\n            drawGame()\n        } else if (gameState == \"end\") {\n            drawEnd()\n        } else {\n            drawThanks()\n        }\n    }\n}\n"},{"type":"added","filename":"rooms.ts","value":"namespace Harmonics {\n    export function loadRoom(index: number): void {\n        roomIndex = clamp(index, 0, 2)\n        activePlayer = 0\n        fogProgress = roomIndex == 0 ? 0 : 1\n        breathClock = 0\n        lastBreathTime = -9\n        exitTimer = 0\n        corePlaced = false\n        coreHeldBy = -1\n        coreVY = 0\n\n        // Every room starts with the same two characters.\n        playerX = [50 * SCALE_X, 100 * SCALE_X]\n        playerY = [480 * SCALE_Y - PLAYER_H, 480 * SCALE_Y - PLAYER_H]\n        playerVY = [0, 0]\n        playerOnGround = [false, false]\n        playerHolding = [false, false]\n        playerFacing = [1, 1]\n\n        floatingPlatforms = []\n        gateRect = { x: 0, y: 0, w: 0, h: 0 }\n        plateRect = { x: 0, y: 0, w: 0, h: 0 }\n        gateStyle = \"\"\n\n        if (roomIndex == 0) {\n            basePlatforms = [\n                { x: 0, y: 480 * SCALE_Y, w: 300 * SCALE_X, h: 60 * SCALE_Y },\n                { x: 660 * SCALE_X, y: 480 * SCALE_Y, w: 300 * SCALE_X, h: 60 * SCALE_Y }\n            ]\n            floatingPlatforms = [\n                { x: 330 * SCALE_X, y: 430 * SCALE_Y, w: 90 * SCALE_X, h: 14 * SCALE_Y },\n                { x: 450 * SCALE_X, y: 385 * SCALE_Y, w: 90 * SCALE_X, h: 14 * SCALE_Y },\n                { x: 570 * SCALE_X, y: 430 * SCALE_Y, w: 90 * SCALE_X, h: 14 * SCALE_Y }\n            ]\n            coreType = \"\"\n        } else if (roomIndex == 1) {\n            basePlatforms = [\n                { x: 0, y: 480 * SCALE_Y, w: 960 * SCALE_X, h: 60 * SCALE_Y },\n                { x: 380 * SCALE_X, y: 400 * SCALE_Y, w: 130 * SCALE_X, h: 14 * SCALE_Y }\n            ]\n            coreType = \"heavy\"\n            coreX = 170 * SCALE_X\n            coreY = 440 * SCALE_Y\n            plateRect = {\n                x: 410 * SCALE_X,\n                y: 400 * SCALE_Y,\n                w: 70 * SCALE_X,\n                h: 2\n            }\n            gateRect = {\n                x: 650 * SCALE_X,\n                y: 300 * SCALE_Y,\n                w: 24 * SCALE_X,\n                h: 180 * SCALE_Y\n            }\n            gateStyle = \"door\"\n        } else {\n            basePlatforms = [\n                { x: 0, y: 480 * SCALE_Y, w: 300 * SCALE_X, h: 60 * SCALE_Y },\n                { x: 640 * SCALE_X, y: 480 * SCALE_Y, w: 320 * SCALE_X, h: 60 * SCALE_Y }\n            ]\n            coreType = \"spark\"\n            coreX = 180 * SCALE_X\n            coreY = 440 * SCALE_Y\n            plateRect = {\n                x: 680 * SCALE_X,\n                y: 480 * SCALE_Y,\n                w: 70 * SCALE_X,\n                h: 2\n            }\n            gateRect = {\n                x: 300 * SCALE_X,\n                y: 480 * SCALE_Y,\n                w: 340 * SCALE_X,\n                h: 14 * SCALE_Y\n            }\n            gateStyle = \"bridge\"\n        }\n\n        exitRect = {\n            x: 850 * SCALE_X,\n            y: 400 * SCALE_Y,\n            w: 60 * SCALE_X,\n            h: 92 * SCALE_Y\n        }\n\n        createActors()\n        createCoreActor()\n        syncActors()\n    }\n\n    export function getSolidRects(): Rect[] {\n        let result: Rect[] = []\n\n        for (let i = 0; i < basePlatforms.length; i++) {\n            result.push(basePlatforms[i])\n        }\n\n        if (roomIndex == 0 && fogProgress >= 1) {\n            for (let i = 0; i < floatingPlatforms.length; i++) {\n                result.push(floatingPlatforms[i])\n            }\n        }\n\n        if (gateStyle == \"door\" && !corePlaced) {\n            result.push(gateRect)\n        }\n\n        if (gateStyle == \"bridge\" && corePlaced) {\n            result.push(gateRect)\n        }\n\n        return result\n    }\n\n    export function nextRoom(): void {\n        if (roomIndex < 2) {\n            loadRoom(roomIndex + 1)\n            playChime(660, 180)\n        } else {\n            finishGame()\n        }\n    }\n\n    export function restartRoom(): void {\n        loadRoom(roomIndex)\n    }\n}"},{"type":"added","filename":"state.ts","value":"namespace Harmonics {\n    export const SCREEN_W = 160\n    export const SCREEN_H = 120\n\n    // The original prototype used a 960 x 540 canvas. These scale factors\n    // translate its room layout into MakeCode Arcade's 160 x 120 screen.\n    export const SCALE_X = 1 / 6\n    export const SCALE_Y = 1 / 4.5\n\n    export interface Rect {\n        x: number\n        y: number\n        w: number\n        h: number\n    }\n\n    export let gameState = \"menu\"\n    export let selectedMode = 1\n    export let mode = 1\n    export let activePlayer = 0\n    export let roomIndex = 0\n\n    export let moodIndex = -1\n    export let preMood = -1\n    export let endMoodIndex = 0\n    export let soundEnabled = true\n\n    export let fogProgress = 0\n    export let breathClock = 0\n    export let lastBreathTime = -9\n    export let exitTimer = 0\n\n    export let backgroundImage: Image = null\n\n    export let playerSprites: Sprite[] = []\n    export let playerX: number[] = []\n    export let playerY: number[] = []\n    export let playerVY: number[] = []\n    export let playerOnGround: boolean[] = []\n    export let playerHolding: boolean[] = []\n    export let playerFacing: number[] = []\n\n    export const PLAYER_W = 5\n    export const PLAYER_H = 9\n    export const PLAYER_GRAVITY = 333\n\n    export let coreSprite: Sprite = null\n    export let coreType = \"\"\n    export let coreX = 0\n    export let coreY = 0\n    export let coreVY = 0\n    export let coreHeldBy = -1\n    export let corePlaced = false\n\n    export let basePlatforms: Rect[] = []\n    export let floatingPlatforms: Rect[] = []\n    export let gateRect: Rect = { x: 0, y: 0, w: 0, h: 0 }\n    export let gateStyle = \"\"\n    export let plateRect: Rect = { x: 0, y: 0, w: 0, h: 0 }\n    export let exitRect: Rect = { x: 0, y: 0, w: 0, h: 0 }\n\n    export let lastTick = 0\n\n    export function clamp(value: number, low: number, high: number): number {\n        return Math.max(low, Math.min(high, value))\n    }\n\n    export function roomName(index: number): string {\n        if (index == 0) return \"BREATHE\"\n        if (index == 1) return \"WEIGHT\"\n        return \"SPARK\"\n    }\n\n    export function roomHintOne(index: number): string {\n        if (index == 0) return \"HOLD B IN / RELEASE B OUT\"\n        if (index == 1) return \"HEAVY CORE SLOWS ITS CARRIER\"\n        return \"SPARK CORE MAKES YOU FASTER\"\n    }\n\n    export function roomHintTwo(index: number): string {\n        if (index == 0) return \"CLEAR FOG TO REVEAL THE PATH\"\n        if (index == 1) return \"PASS THE CORE TO THE PLATE\"\n        return \"PLACE THE CORE TO GROW A BRIDGE\"\n    }\n\n    export function moodName(index: number): string {\n        if (index < 0) return \"SKIP\"\n        if (index == 0) return \"SETTLED\"\n        if (index == 1) return \"TENSE\"\n        return \"OVERWHELMED\"\n    }\n}"}]},{"timestamp":1795671829815,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"pxt.json","patch":[{"start1":387,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"},{"type":"added","filename":"main.blocks","value":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>"}]}],"snapshots":[{"timestamp":1795500150688,"editorVersion":"4.1.28","text":{"main.ts":" ","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"SEROUE\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-onl